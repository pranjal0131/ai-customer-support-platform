APP_NAME=SupportIQ
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/supportiq.db
# Docker Compose overrides this with PostgreSQL.
POSTGRES_DB=supportiq
POSTGRES_USER=supportiq
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
MODEL_DIR=./models
DATA_DIR=./data
DEMO_MODE=true
MAX_TICKET_LENGTH=10000
VITE_API_URL=http://localhost:8000
